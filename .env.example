# Origem pública da API PostgreSQL, sem /delta no final.
# Copie para .env.local e preencha com o endereço do seu ambiente.
VITE_POSTGRES_API_URL=

# Opcional: substitui as cinco regiões tarifárias confirmadas para este projeto.
# JSON com itens {"id": número positivo, "name": "Nome da região"}.
VITE_TARIFF_REGIONS=
