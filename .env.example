# Origens públicas das APIs, sem barra no final e sem chaves de serviço.
# Copie para .env.local; nunca versione segredos.
# API PostgreSQL (sem /delta no final).
VITE_POSTGRES_API_URL=https://delta-app-a3po.onrender.com
# API de ranking (Redis).
VITE_RANKING_API_URL=https://delta-api-redis.onrender.com
# API de IA (chatbot).
VITE_AI_API_URL=https://delta-artificial-intelligence-mvo1.onrender.com
# API de telemetria e resumos do MongoDB.
VITE_MONGO_API_URL=https://delta-api-mongo.onrender.com
# Previsão do tempo (Open-Meteo).
VITE_WEATHER_API_URL=https://api.open-meteo.com/v1/forecast

# Opcional: substitui as cinco regiões tarifárias confirmadas para este projeto.
# JSON com itens {"id": número positivo, "name": "Nome da região"}.
VITE_TARIFF_REGIONS=
